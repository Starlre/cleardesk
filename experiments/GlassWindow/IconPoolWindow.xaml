<local:SurfaceWindow x:Class="ClearDesk.GlassWindow.IconPoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClearDesk.GlassWindow"
        Title="澄桌 · 图标池" Width="880" Height="620" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="False" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="PoolTile" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Body" CornerRadius="12" Margin="4" Padding="10" BorderThickness="1"
                                BorderBrush="Transparent" Background="{DynamicResource ControlFill}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource HoverFill}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="32" Background="{DynamicResource SurfaceTint}" BorderBrush="{DynamicResource SurfaceEdge}" BorderThickness="1">
        <Grid>
        <local:GlassEdge Radius="31" />
        <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" /><RowDefinition Height="30" /><RowDefinition Height="58" />
                <RowDefinition Height="*" /><RowDefinition Height="58" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock Text="图标池" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource QuietButton}" Click="OnClose" Background="Transparent" BorderBrush="Transparent"
                        Padding="10,6" HorizontalAlignment="Right" ToolTip="关闭图标池" AutomationProperties.Name="关闭图标池">
                    <Path Data="M0,0 L12,12 M0,12 L12,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="12" Height="12" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="选择想放在面板上的应用，然后点击「添加到面板」。" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12" />
            <Grid Grid.Row="2" Margin="0,8,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="{DynamicResource SurfaceEdge}" BorderThickness="1" Background="{DynamicResource ControlFill}" Padding="12,0">
                    <Grid>
                        <TextBox x:Name="PoolSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" VerticalContentAlignment="Center" AutomationProperties.Name="搜索图标池" />
                        <TextBlock Text="搜索图标池" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="从文件导入" Click="OnImport" Style="{StaticResource QuietButton}" Margin="12,0,0,0" />
            </Grid>
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VisibleEntries}" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox Width="150" Height="126" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                      Style="{StaticResource PoolTile}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" Margin="0,8,0,6" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                    <TextBlock Text="{Binding SelectionHint}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="没有匹配的应用，可从文件导入。" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VisibleEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PoolLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" MaxWidth="410" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SelectionLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="取消" Style="{StaticResource QuietButton}" Click="OnClose" Background="Transparent" BorderBrush="Transparent" Margin="0,0,8,0" />
                    <Button x:Name="AddSelectedButton" Content="添加到面板" Style="{StaticResource QuietButton}" Click="OnAddSelected" IsEnabled="{Binding CanAdd}" />
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</local:SurfaceWindow>
